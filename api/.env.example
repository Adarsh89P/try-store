PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/saree-store
# Long random string. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Comma-separated emails that become admins when they register.
ADMIN_EMAILS=
# Websites and app that may call this API (comma-separated). TODO: add your real domains.
CORS_ORIGINS=http://localhost:3000,http://localhost:8081
# Public address where product photos are served (the website). Needed by the try-on model.
ASSET_BASE_URL=http://localhost:3000
# TODO: set the delivery charge in rupees.
DELIVERY_FEE_INR=0

# Razorpay (https://dashboard.razorpay.com). Leave empty to disable online payment.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# AI try-on: "mock" returns the customer's own photo (for building the flow), "replicate" calls a model.
TRYON_PROVIDER=mock
REPLICATE_API_TOKEN=
# TODO: version id of the virtual try-on model you choose on Replicate.
TRYON_MODEL_VERSION=
